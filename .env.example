# Dungeon Achievements Generator - Environment Configuration
# Copy this file to .env.local for local development

# AWS Configuration
AWS_REGION=us-west-2
AWS_PROFILE=kibler

# Bedrock Configuration  
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Alternative models (uncomment to test):
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0   # Faster, less creative
# BEDROCK_MODEL_ID=anthropic.claude-3-opus-20240229-v1:0    # Most creative, slowest

# Development Configuration
PORT=3000
NODE_ENV=development

# Cloudflare Configuration (for deployment domain setup)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_for_carlkibler_com

# Feature Flags (for future use)
ENABLE_RATE_LIMITING=false
ENABLE_ANALYTICS=false
ENABLE_CACHING=false