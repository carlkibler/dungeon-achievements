{
  "name": "dungeon-achievements",
  "version": "2.0.0",
  "description": "Dungeon Crawler Carl style achievement generator — Cloudflare Pages + OpenRouter",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "analytics": "node scripts/analytics-report.js",
    "provision-token": "node scripts/provision-token.js",
    "postinstall": "node scripts/check-deps-age.js",
    "vendor:justif": "cp node_modules/justif/dist/auto.js public/vendor/justif/auto.js && cp node_modules/justif/LICENSE public/vendor/justif/LICENSE && node -p \"require('justif/package.json').version\" > public/vendor/justif/VERSION",
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "serve:node": "tsx server.ts"
  },
  "dependencies": {
    "openai": "4.104.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "@types/node": "25.9.1",
    "axe-core": "4.12.1",
    "justif": "0.6.5",
    "playwright": "1.62.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  },
  "license": "MIT",
  "overrides": {
    "@napi-rs/wasm-runtime": "1.2.0",
    "@oxc-project/types": "0.142.0",
    "@speed-highlight/core": "1.2.17",
    "nanoid": "3.3.16",
    "postcss": "8.5.24",
    "rolldown": "1.2.0",
    "tinyexec": "1.2.4",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
