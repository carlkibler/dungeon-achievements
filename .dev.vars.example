# Copy this file to .dev.vars and fill in your values
# .dev.vars is gitignored — never commit it

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: model to use (default: anthropic/claude-haiku-4.5)
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: model for the parallel triage call that reads the activity for hard limits.
# Defaults to OPENROUTER_MODEL. Any cheap, fast instruct model works.
# OPENROUTER_TRIAGE_MODEL=anthropic/claude-haiku-4.5

# Optional: deploy token used by `make deploy`, needs Cloudflare Pages: Edit.
# Only needed if you deploy with a scoped token instead of `wrangler login`
# (which is what plain `npm run deploy` uses).
# CLOUDFLARE_API_TOKEN=
